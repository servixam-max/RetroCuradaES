{"type": "file", "p": "clubkprz.zip", "n": "clubkprz", "ext": ".zip", "parent": "", "urls": [{"u": "https://archive.org/download/recalbox-naomi2-retroninjasamurai/clubkprz.zip", "size": "98.76 MB", "size_bytes": 103557365}], "meta": {"path": "./clubkprz.zip", "name": "Club Kart Prize", "desc": "⬇ Tamaño de descarga: 98.76 MB\n\nComo su nombre indica, esta versión del Club Kart otorgará los premios a los jugadores en función de cómo jueguen - recogerás las monedas que te serán entregadas al final de la carrera.", "image": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/clubkprz-image.jpg", "thumbnail": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/clubkprz-thumb.jpg", "marquee": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/clubkprz-marquee.png", "video": "Z:/Digistorage/Arley4dCloudMedia/naomi2/videos/clubkprz-video.mp4", "fanart": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/clubkprz-fanart.jpg", "boxback": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/clubkprz-boxback.jpg", "releasedate": "20030101T000000", "developer": "SEGA", "publisher": "SEGA", "genre": "Carreras, Conducción / Carreras 3ª persona", "players": "1-2", "region": "us", "md5": "96d6696d60355f453b36e54740dbd038", "bezel": "./images/clubkprz-bezel.png", "family": "Club Kart", "lang": "en"}, "size_bytes": 103557365, "size": "98.76 MB"}
{"type": "file", "p": "kingrt66.zip", "n": "kingrt66", "ext": ".zip", "parent": "", "urls": [{"u": "https://archive.org/download/recalbox-naomi2-retroninjasamurai/kingrt66.zip", "size": "126.86 MB", "size_bytes": 133022351}], "meta": {"path": "./kingrt66.zip", "name": "The King of Route 66", "desc": "⬇ Tamaño de descarga: 126.86 MB\n\nJuego de conducción del estilo de \"18 Wheeler\". El juego tiene lugar en la famosa Route 66, una carretera que atraviesa América de Illinois a California.\nEste juego presenta un modo de historia en el que la Evil Tornado Corporation se ha hecho cargo de todos los trabajos de transporte por carretera a lo largo de la ruta 66. Juegas con un heroico camionero que desafía a los conductores de Tornado a lo largo de toda la ruta y los pone en su lugar llevando su carga al destino primero.", "image": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/kingrt66-image.jpg", "thumbnail": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/kingrt66-thumb.jpg", "marquee": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/kingrt66-marquee.png", "video": "Z:/Digistorage/Arley4dCloudMedia/naomi2/videos/kingrt66-video.mp4", "fanart": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/kingrt66-fanart.jpg", "boxback": "Z:/Digistorage/Arley4dCloudMedia/naomi2/images/kingrt66-boxback.jpg", "releasedate": "20020101T000000", "developer": "SEGA", "publisher": "SEGA", "genre": "Carreras, Conducción", "players": "1-2", "region": "us", "md5": "3039b09c047f9a22acdf37c0fbb93264", "bezel": "./images/kingrt66-bezel.png", "lang": "en"}, "size_bytes": 133022351, "size": "126.86 MB"}
